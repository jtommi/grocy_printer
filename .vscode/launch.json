    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "justMyCode": true,
            "args": [
                "main:app",
                "--reload",
                "--host",
                "127.0.0.1"
            ],
            "env": {
                "PYTHONUNBUFFERED": "1",
                "DEV": "1"
            },
            "console": "integratedTerminal"
        }
    ]
}